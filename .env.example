# GitLab OAuth application used by the local supervisor console.
GITLAB_HOST=https://gitlab.example.com
GITLAB_APP_ID=
GITLAB_APP_SECRET=

# Optional. When omitted, the supervisor uses the directory from which it was
# started. Set this only when launching it outside the repository root.
# AGENT_DAEMON_DEV_PROJECT_PATH=/absolute/path/to/agent-daemon-rb
