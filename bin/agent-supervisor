#!/usr/bin/env ruby
# frozen_string_literal: true

$stdout.sync = true

require_relative "../lib/agent_daemon"
require_relative "../lib/agent_daemon/supervisor/master"

config_path = ARGV[0]

unless config_path && File.exist?(config_path)
  warn "Config not found: #{config_path}"
  warn "Usage: #{$PROGRAM_NAME} <supervisor-config.yml>"
  exit 1
end

config = AgentDaemon::Supervisor::Config.new(config_path)

logger = ::Logger.new($stdout)
# DEBUG here so the per-tag ambient level gate (Log.bind_context) is the
# authoritative filter — a workflow configured for `logging.level: debug`
# would otherwise still be dropped by this shared logger before its own
# gate ever runs (AD-11/Story 1.7). Per-workflow `logging.file`/`output`
# are deliberately ignored under the supervisor: one shared $stdout sink
# for the whole fleet, only `logging.level` is consumed (per-tag).
logger.level = ::Logger::DEBUG
logger.formatter = proc { |severity, _datetime, _progname, msg| "#{severity}: #{msg}\n" }
AgentDaemon::Log.use(logger)

AgentDaemon::Log.info("Loaded supervisor config from #{config_path}")

master = AgentDaemon::Supervisor::Master.new(config)
master.start
